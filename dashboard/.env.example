# Copy to .env.local and adjust. Never commit secrets.
# true = synthetic demo fixtures (src/mocks), false = Mossab's API
VITE_USE_MOCKS=true
# Base URL of the Spring Boot API (port to confirm with Mossab; 8080 is taken by the Spark UI)
VITE_API_URL=http://localhost:8081
# Polling interval for Live/Alerts/Sentiment in ms
VITE_REFRESH_MS=30000
VITE_SYMBOLS=BTCUSDT,ETHUSDT
