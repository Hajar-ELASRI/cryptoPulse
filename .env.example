KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# Optional Docker image overrides, otherwise Compose uses its pinned versions.
# KAFKA_IMAGE=apache/kafka:4.3.1
# SPARK_IMAGE=apache/spark:3.5.4-python3
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=crypto_pulse
BINANCE_SYMBOLS=btcusdt,ethusdt
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
RSS_POLL_SECONDS=300
REDDIT_SUBREDDITS=CryptoCurrency,Bitcoin
REDDIT_POLL_SECONDS=300
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CryptoPulse/0.1 by YOUR_REDDIT_USERNAME
SENTIMENT_GROUP_ID=cryptopulse-sentiment-v1
HISTORY_DIR=/data/history
HISTORY_SYMBOLS=BTCUSDT,ETHUSDT
HISTORY_MONTHS=3
# Optional fixed completed months (YYYY-MM, comma separated); overrides HISTORY_MONTHS.
HISTORY_PERIODS=
# 0 imports the whole archive; use 1000 for an initial sample per archive.
HISTORY_MAX_ROWS=0
HISTORY_BATCH_SIZE=2000
